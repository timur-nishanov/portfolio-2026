{
  "headers": [
    {
      "source": "/(mockups|cases|random|head|awards|icons|logos|sounds)/(.*)\\.(mp4|webp|png|jpg|svg|mp3)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
